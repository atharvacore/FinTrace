# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# Runtime environment: development | test | production
FINTRACE_ENV=development

# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
FINTRACE_DATABASE_URL=postgresql+psycopg://fintrace:CHANGE_ME@localhost:5432/fintrace

# Used by docker-compose for the database container
POSTGRES_USER=fintrace
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fintrace
# Host port for the database container (change if 5432 is already in use)
POSTGRES_PORT=5432

# JWT signing secret: at least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FINTRACE_JWT_SECRET=CHANGE_ME
FINTRACE_ACCESS_TOKEN_MINUTES=60

# Comma-separated list of allowed browser origins for the React dev server
FINTRACE_CORS_ORIGINS=http://localhost:5173

# Directory holding the trained model artifact (created by the ml pipeline)
FINTRACE_MODEL_DIR=ml/artifacts/current
